# Ambiente: development | production
ENVIRONMENT=development

# OpenAI Configuration
OPENAI_API_KEY=
OPENAI_ORG_ID=

# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg://usuario:senha@host:porta/nome_do_banco

# Firebase Admin SDK
# Firebase Console -> Project Settings -> Service accounts -> Generate new private key
# Cole o conteúdo do JSON inteiro como uma única linha (string)
FIREBASE_SERVICE_ACCOUNT_JSON=

# CORS: lista de origens separadas por vírgula (obrigatório em produção)
CORS_ORIGINS=

# Monetização. Mantenha false enquanto o app for publicado gratuito: nesse modo
# ninguém perde acesso pelo fim do trial e as rotas de compra respondem 404.
# Só ligue depois de implementar a validação de recibo em
# app/services/pagamento_service.py, senão a ativação falha com 501.
COBRANCA_ATIVA=false
