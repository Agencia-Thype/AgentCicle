# Ambiente: development | production
ENVIRONMENT=development

# OpenAI Configuration
OPENAI_API_KEY=
OPENAI_ORG_ID=

# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg://usuario:senha@host:porta/nome_do_banco

# Firebase Admin SDK
# Firebase Console -> Project Settings -> Service accounts -> Generate new private key
# Cole o conteúdo do JSON inteiro como uma única linha (string)
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_FILE=

# CORS: lista de origens separadas por vírgula (obrigatório em produção)
CORS_ORIGINS=

# Monetização. Mantenha false enquanto o app for publicado gratuito: nesse modo
# ninguém perde acesso pelo fim do trial e as rotas de compra respondem 404.
# Só ligue depois de cadastrar os produtos nas lojas e preencher as chaves
# abaixo: sem elas a ativação falha fechado (503) e ninguém consegue pagar.
COBRANCA_ATIVA=false

# Dias de teste grátis de uma conta nova (padrão: 3)
DIAS_TRIAL=3

# Validação de compras - obrigatório antes de ligar COBRANCA_ATIVA
# Google Play: JSON da service account, por caminho ou inteiro
GOOGLE_PLAY_SERVICE_ACCOUNT=
ANDROID_PACKAGE_NAME=com.agentcicle.app
# App Store: chave .p8 criada em App Store Connect > Integrações > Chaves
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
APPLE_BUNDLE_ID=com.agentcicle.app
# Produtos das lojas: id:meses,id:meses
PRODUTOS_ASSINATURA=ciclica_premium_mensal:1,ciclica_premium_anual:12

# Segredo das notificações das lojas (webhooks de renovação/cancelamento).
# Acrescente ?token=<valor> na URL cadastrada na Apple e no Google.
NOTIFICACOES_LOJA_TOKEN=
